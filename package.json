{
  "name": "@moonglade/editor",
  "version": "0.5.0",
  "private": true,
  "description": "Unified ProseMirror and CodeMirror editor package for Moonglade.",
  "type": "module",
  "license": "MIT",
  "module": "./dist/moonglade-editor.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/moonglade-editor.js"
    },
    "./style.css": "./dist/moonglade-editor.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "types": "tsc -p tsconfig.build.json",
    "bundle": "node scripts/build.mjs",
    "size": "node scripts/check-size.mjs",
    "build": "npm run clean && npm run types && npm run bundle && npm run size",
    "dev": "node scripts/build.mjs --watch",
    "demo:upload": "node scripts/upload-test-server.mjs",
    "pack:nuget": "node scripts/pack-nuget.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@lezer/highlight": "^1.2.3",
    "prettier": "^3.9.6",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.11",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-view": "^1.42.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "esbuild": "0.28.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7"
  }
}
